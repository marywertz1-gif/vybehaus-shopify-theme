
<section class="vybe-collection">
  <div class="vybe-collection-container">

    <header class="vybe-collection-header">
      <h1 class="vybe-collection-title">
        {{ collection.title | escape }}
      </h1>

      {% if collection.description != blank %}
        <div class="vybe-collection-description">
          {{ collection.description }}
        </div>
      {% endif %}
    </header>

    {% paginate collection.products by 12 %}

      {% if collection.products.size > 0 %}

        <div class="vybe-product-grid">
          {% for product in collection.products %}
            <a
              href="{{ product.url }}"
              class="vybe-product-card"
            >

              <div class="vybe-product-image">
                {% if product.featured_image %}
                  {{
                    product.featured_image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      alt: product.title
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </div>

              <div class="vybe-product-info">
                <h2>{{ product.title | escape }}</h2>

                <p class="vybe-product-price">
                  {{ product.price | money }}
                </p>

                {% unless product.available %}
                  <span class="vybe-sold-out">
                    SOLD OUT
                  </span>
                {% endunless %}
              </div>

            </a>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <nav class="vybe-pagination" aria-label="Collection pages">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}

      {% else %}

        <div class="vybe-empty-collection">
          <h2>COMING SOON</h2>
          <p>Something exciting is on its way.</p>

          <a href="{{ routes.root_url }}">
            BACK TO HOME
          </a>
        </div>

      {% endif %}

    {% endpaginate %}

  </div>
</section>

<style>
  .vybe-collection {
    background: #08050f;
    color: #ffffff;
    min-height: 80vh;
    padding: 70px 20px;
  }

  .vybe-collection-container {
    max-width: 1300px;
    margin: 0 auto;
  }

  .vybe-collection-header {
    text-align: center;
    margin-bottom: 55px;
  }

  .vybe-collection-title {
    font-size: clamp(40px, 7vw, 85px);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 5px;
    color: #e9d5ff;
    text-shadow:
      0 0 10px #a855f7,
      0 0 25px #9333ea,
      0 0 55px #7e22ce;
  }

  .vybe-collection-description {
    max-width: 650px;
    margin: 20px auto;
    color: #d8b4fe;
    line-height: 1.7;
  }

  .vybe-product-grid {
    display: grid;
    grid-template-columns:
      repeat(auto-fill, minmax(230px, 1fr));
    gap: 30px;
  }

  .vybe-product-card {
    display: block;
    background: #130c20;
    border: 1px solid #392050;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: #ffffff;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .vybe-product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 0 25px #9333ea80;
  }

  .vybe-product-image {
    aspect-ratio: 1;
    background: #1b112b;
    overflow: hidden;
  }

  .vybe-product-image img,
  .vybe-product-image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vybe-product-info {
    padding: 20px;
  }

  .vybe-product-info h2 {
    font-size: 17px;
    margin: 0 0 12px;
    color: #ffffff;
  }

  .vybe-product-price {
    font-size: 19px;
    font-weight: bold;
    color: #d8b4fe;
  }

  .vybe-sold-out {
    display: inline-block;
    margin-top: 10px;
    font-size: 12px;
    letter-spacing: 2px;
    color: #f0abfc;
  }

  .vybe-pagination {
    text-align: center;
    margin-top: 50px;
  }

  .vybe-pagination a,
  .vybe-pagination span {
    color: #d8b4fe;
    margin: 0 8px;
  }

  .vybe-empty-collection {
    text-align: center;
    padding: 80px 20px;
  }

  .vybe-empty-collection h2 {
    font-size: 35px;
    color: #d8b4fe;
    text-shadow: 0 0 20px #9333ea;
  }

  .vybe-empty-collection p {
    color: #cccccc;
  }

  .vybe-empty-collection a {
    display: inline-block;
    margin-top: 25px;
    padding: 14px 28px;
    border: 1px solid #a855f7;
    border-radius: 30px;
    color: #ffffff;
  }
</style>

{% schema %}
{
  "name": "VYBE Collection",
  "settings": []
}
{% endschema %}
