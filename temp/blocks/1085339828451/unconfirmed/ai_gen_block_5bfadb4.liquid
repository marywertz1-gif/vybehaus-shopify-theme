{% doc %}
  @prompt
    can you link this to my beauty collection
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-link-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-collection-link-{{ ai_gen_id }}__anchor {
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.alignment }};
    gap: 10px;
    width: 100%;
    box-sizing: border-box;
    padding: 14px 18px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    font: inherit;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .ai-collection-link-{{ ai_gen_id }}__anchor:hover {
    color: {{ block.settings.hover_text_color }};
    background: {{ block.settings.hover_background_color }};
  }

  .ai-collection-link-{{ ai_gen_id }}__anchor:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .ai-collection-link-{{ ai_gen_id }}__arrow {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
  }
{% endstyle %}

{% assign target_collection = block.settings.collection | default: collections['beauty'] %}
{% assign link_label = block.settings.link_label | default: target_collection.title | default: 'Shop the beauty collection' %}

<div class="ai-collection-link-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if target_collection != blank %}
    <a class="ai-collection-link-{{ ai_gen_id }}__anchor" href="{{ target_collection.url }}" aria-label="{{ link_label | escape }}">
      <span>{{ link_label | escape }}</span>
      <svg class="ai-collection-link-{{ ai_gen_id }}__arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  {% elsif request.design_mode %}
    <div class="ai-collection-link-{{ ai_gen_id }}__anchor">Choose a collection in this block’s settings.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Beauty collection link",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop the beauty collection"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#777777"
    },
    {
      "type": "color",
      "id": "hover_text_color",
      "label": "Hover text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "hover_background_color",
      "label": "Hover background",
      "default": "#222222"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Beauty collection link"
    }
  ],
  "tag": null,
  "class": "beauty-collection-link-block"
}
{% endschema %}